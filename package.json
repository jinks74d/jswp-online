{
  "name": "jswp-online",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:debug": "next build --debug",
    "build:trace": "ANALYZE=true next build",
    "build:analyze": "ANALYZE=true npm run build",
    "type-check": "tsc --noEmit",
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "next start",
    "clean": "rm -rf .next && rm -rf node_modules/.cache",
    "clean:all": "rimraf .next node_modules/.cache .turbo",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "health-check": "curl -f http://localhost:3000/api/health || exit 1",
    "performance-audit": "lighthouse http://localhost:3000 --output=json --output-path=./lighthouse-report.json",
    "seed:auth": "tsx scripts/seed-auth.ts",
    "db:check": "tsx scripts/db-check.ts",
    "backfill:source-html": "tsx scripts/backfill-source-html.ts",
    "reextract:pdf-sources": "tsx scripts/reextract-pdf-sources.ts",
    "test:rls": "vitest run --config __tests__/schema/vitest.config.ts",
    "test:all": "npm run test:run && npm run test:rls",
    "verify": "npm run lint && npm run type-check && npm run test:all && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/dompurify": "^3.0.5",
    "@types/lodash-es": "^4.17.12",
    "@types/papaparse": "^5.3.16",
    "autoprefixer": "^10.4.21",
    "docx-preview": "^0.3.7",
    "dompurify": "^3.2.6",
    "dotenv": "^17.2.1",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.446.0",
    "mammoth": "^1.12.0",
    "next": "^15.5.18",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "6.0.227",
    "react": "^18.3.1",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.3.1",
    "react-to-print": "^3.1.1",
    "resend": "^6.12.3",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.2",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.0.3",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
